# Edit these before docker compose up. Never commit .env.
# BIND_ADDRESS=0.0.0.0 if BE connects from another host.
BIND_ADDRESS=127.0.0.1
API_PORT=8002
API_TOKEN=CHANGE_ME_generate_a_random_token_at_least_24_characters

# Worker -> BE. Enable only after SOAR confirms the endpoint is open.
CALLBACK_ENABLED=false
CALLBACK_URL=http://BE_HOST:8080/api/v1/internal/ai-retrain/status
# Sent as X-AI-Service-Token (not Authorization).
CALLBACK_TOKEN=
CALLBACK_TIMEOUT=10
CALLBACK_RETRY_MAX_SECONDS=60

# Max parallel tenants. Each job has a separate process.
MAX_CONCURRENT_JOBS=2
MAX_PENDING_JOBS=50
MAX_ALERTS=200000
TRAIN_THREADS=2
MAX_TRAIN_SECONDS=14400
CANCEL_GRACE_SECONDS=5
# /cancel waits for success/error and returns CANCEL_FAILED if this limit is exceeded.
# Set the BE HTTP client/proxy timeout above this value (e.g. 210 seconds).
# Calling /cancel again after a failure retries it; no progress response is sent.
CANCEL_ATTEMPT_TIMEOUT=180
IO_TIMEOUT=30
# Docker overrides this to /state on a persistent volume.
STATE_DIR=./state

ES_URL=http://ES_HOST:9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_VERIFY_TLS=true
ES_CA_BUNDLE=
ES_ALERT_INDEX=soar_alerts
ES_EVENT_INDEX=case_events
# _source field paths (NO .keyword here).
ES_TENANT_FIELD=customerCode
# Newly added alerts are reported mistakes: invert TP/FP from this field.
ES_ADDED_LABEL_FIELD=aiLabel
# Legacy base versions without training_alert_labels use this ground truth field.
# Inherited labels are NEVER inverted. New versions save them in the manifest.
ES_LABEL_FIELD=rawData.ai_training.label
ES_POSITIVE_LABEL=TRUE_POSITIVE
ES_NEGATIVE_LABEL=FALSE_POSITIVE
# IMPORTANT: choose id, alertId, or _id to match the ES environment.
ES_EVENT_LINK_SOURCE=id
# Exact-match searchable field; may need alertId instead of alertId.keyword.
ES_EVENT_LINK_FIELD=alertId.keyword
ES_EVENT_DATA_FIELD=event
ES_ROUTING=
ES_BATCH_SIZE=500
# Set true only after checking the fields and tenant/event association above.
ES_MAPPING_CONFIRMED=false

# S3 API endpoint uses port 9000, not the Console port 9001.
MINIO_ENDPOINT=http://MINIO_HOST:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=soar-models
MINIO_REGION=us-east-1
MINIO_VERIFY_TLS=true
MINIO_CA_BUNDLE=
